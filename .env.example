# Copy this file to .env and fill in ONE key. Never commit .env.

# Which AI to use: gemini (free tier) or claude (paid)
AI_PROVIDER=gemini

# Free: get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Paid: get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# --- For the phone app (mobile/) ---
# Let your phone reach this server over Wi-Fi. Remove the line to keep it private to this computer.
HOST=0.0.0.0
# Optional app password: phones must send the same value (EXPO_PUBLIC_LADLE_TOKEN in mobile/.env.local)
LADLE_TOKEN=

# Optional: override the models (leave blank for the defaults in server.js)
# MODEL_QUICK=gemini-2.5-flash
# MODEL_DEFAULT=gemini-2.5-flash

PORT=3000
